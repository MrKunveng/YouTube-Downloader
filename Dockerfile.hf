# Dockerfile for Hugging Face Spaces
FROM python:3.11-slim

# Install system dependencies including ffmpeg
RUN apt-get update && apt-get install -y \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY downloader.py .

# Expose port (HF Spaces will set PORT env var)
EXPOSE 7860

# Run Streamlit
# HF Spaces automatically sets PORT environment variable
# Use PORT if set, otherwise default to 7860
CMD streamlit run downloader.py --server.port=${PORT:-7860} --server.address=0.0.0.0 --server.headless=true
